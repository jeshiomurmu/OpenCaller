<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Debug builds only: commands for the emulator QA script (scripts/qa/blocking.sh). Protected by DUMP, which
            only the shell (adb) and the system hold, so other apps can't drive it.
        -->
        <receiver
            android:name=".qa.QaCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
