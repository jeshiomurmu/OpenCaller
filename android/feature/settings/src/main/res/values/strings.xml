    <!-- Messenger caller ID (F-ID-05) -->
    <string name="messenger_title">WhatsApp, Telegram and Signal calls</string>
    <string name="messenger_explainer">When one of these apps shows an incoming call with a phone number in its notification, OpenCaller shows what it knows about that number.</string>
    <string name="messenger_privacy">To do this, OpenCaller needs notification access. It looks only at these three apps\' call notifications, and only at their text. Nothing is stored, and nothing is sent anywhere.</string>
    <string name="messenger_switch">Caller ID for messenger calls (supporters)</string>
    <string name="messenger_access_needed">Notification access is off, so nothing can be shown yet.</string>
    <string name="messenger_open_access">Open notification access</string>
    <string name="messenger_no_number_note">If the app shows a name instead of a number (a contact in that app), OpenCaller shows nothing.</string>
