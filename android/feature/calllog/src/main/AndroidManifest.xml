<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The call log (docs/prd.md F-CM-03). Requested only while OpenCaller is the default phone app, after an explainer
        (Play policy; docs/architecture.md §5). The log is read and changed on the phone only, never uploaded.
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />

</manifest>
