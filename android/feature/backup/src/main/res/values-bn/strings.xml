<resources>
    <string name="backup_title">ব্যাকআপ ও রিস্টোর</string>
    <string name="backup_intro">আপনার সেটিংস, ব্লক করার নিয়ম, কল স্ক্রিনিংয়ের ইতিহাস ও মেসেজের বিভাগ, আপনার বেছে নেওয়া পাসফ্রেজ দিয়ে এনক্রিপ্ট করা একটি ফাইলে। আপনার মেসেজ, কন্টাক্ট ও কল লগ Android-এই থাকে, ফাইলে নয়। এককালীন কোড কখনো ব্যাকআপ হয় না।</string>
    <string name="backup_passphrase">পাসফ্রেজ</string>
    <string name="backup_confirm">আবার পাসফ্রেজ</string>
    <string name="backup_passphrase_hint">অন্তত ৮টি অক্ষর। এটি ছাড়া কেউ ব্যাকআপ খুলতে পারবে না, আপনিও না: এটি রিসেট করা যায় না।</string>
    <string name="backup_file_title">একটি ফাইল</string>
