    <string name="backup_drive_title">Google Drive</string>
    <string name="backup_drive_body">আপনার Google Drive-এর একটি লুকানো ফোল্ডারে রাখা হয়, যা শুধু OpenCaller খুলতে পারে। আগে ফোনেই এনক্রিপ্ট করা হয়।</string>
    <string name="backup_to_drive">Google Drive-এ ব্যাকআপ নিন</string>
