<resources>
    <!-- Setup (docs/prd.md F-UT-04) -->
    <string name="assistant_title">Call assistant</string>
    <string name="assistant_intro">When you don\'t answer, your calls can go to an automated assistant. It tells the caller it is an assistant, asks who is calling and why, and shows you the conversation live. It never asks for codes, passwords or bank details.</string>
    <string name="assistant_privacy">The caller\'s number, the conversation and the summary go only to this phone. The server keeps your minutes, not who called or what was said.</string>
    <string name="assistant_turn_on">Get my assistant number</string>
    <string name="assistant_turn_off">Turn off the assistant</string>
    <string name="assistant_your_number">Your assistant number: %1$s</string>
    <string name="assistant_forwarding_title">Forward unanswered calls</string>
    <string name="assistant_forwarding_intro">Dial each code below. Your phone shows the network\'s answer; most networks confirm with a short message.</string>
    <string name="assistant_code_no_reply">When you don\'t answer</string>
    <string name="assistant_code_unreachable">When your phone is off or has no signal</string>
    <string name="assistant_code_busy">When you are on another call</string>
    <string name="assistant_dial">Dial</string>
    <string name="assistant_cancel_title">Stop forwarding</string>
    <string name="assistant_cancel_text">Dial %1$s to cancel every call forwarding on this SIM, then turn the assistant off.</string>
    <string name="assistant_carrier_title">My carrier doesn\'t support this</string>
    <string name="assistant_carrier_text">Some carriers, prepaid plans and VoLTE networks don\'t accept these codes, or charge for forwarded calls. Look in your phone\'s call settings (Calls → Call forwarding) or your carrier\'s app, and forward to your assistant number there. Ask your carrier about the cost of forwarded calls. If nothing works, your carrier doesn\'t offer conditional forwarding on this plan.</string>
    <string name="assistant_turn_off_title">Turn off the assistant?</string>
    <string name="assistant_turn_off_text">First dial %1$s, or calls keep going to a number that no longer answers for you.</string>
    <string name="assistant_turn_off_confirm">Turn off</string>
    <string name="assistant_cancel">Cancel</string>
    <string name="assistant_usage_title">This month</string>
    <plurals name="assistant_usage">
        <item quantity="one">%1$d of %2$d minute used</item>
        <item quantity="other">%1$d of %2$d minutes used</item>
    </plurals>
    <plurals name="assistant_usage_unlimited">
        <item quantity="one">%1$d minute used</item>
        <item quantity="other">%1$d minutes used</item>
    </plurals>
    <string name="assistant_usage_exhausted">Your minutes for this month are used up. Until next month, callers hear that you can\'t take calls.</string>
