<resources>
    <string name="assistant_title">কল সহকারী</string>
    <string name="assistant_intro">আপনি কল না ধরলে কলটি একটি স্বয়ংক্রিয় সহকারীর কাছে যেতে পারে। এটি কলারকে জানায় যে এটি একটি সহকারী, জিজ্ঞেস করে কে কল করছেন ও কেন, আর আপনাকে কথোপকথনটি সরাসরি দেখায়। এটি কখনো কোড, পাসওয়ার্ড বা ব্যাংকের তথ্য চায় না।</string>
    <string name="assistant_privacy">কলারের নম্বর, কথোপকথন ও সারাংশ শুধু এই ফোনে আসে। সার্ভার শুধু আপনার মিনিটের হিসাব রাখে, কে কল করেছে বা কী বলা হয়েছে তা নয়।</string>
