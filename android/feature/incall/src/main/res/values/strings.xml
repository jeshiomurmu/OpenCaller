    <!-- Recording line (Phase 13, ADR 0009) -->
    <string name="incall_record">Record</string>
    <string name="incall_record_stop">Stop recording</string>
    <string name="incall_record_reminder_title">Record this call?</string>
    <string name="incall_record_reminder_text">OpenCaller calls its recording line and adds it to this call. Both of you hear a beep and an announcement that the call is recorded. You are responsible for following the law where the other person is: some places require everyone\'s consent. The recording is saved on this phone; the server deletes its copy within an hour after that.</string>
