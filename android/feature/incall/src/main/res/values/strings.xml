    <!-- Voice scan (docs/prd.md F-PR-13, ADR 0011). -->
    <string name="incall_scan">Scan voice</string>
    <string name="incall_scan_stop">Stop scan</string>
    <string name="incall_scan_explain_title">Check this voice?</string>
    <string name="incall_scan_explain_text">OpenCaller adds its line to this call for up to a minute. Both of you hear a short beep. Your microphone is muted while it listens to a few seconds of the other person and checks whether the voice sounds generated by a computer, and what they said for common scam phrases. Nothing is recorded or kept; the server keeps only the result, for a day.</string>
    <string name="incall_scan_confirm">Scan</string>
    <string name="incall_scan_connecting">Calling the voice scanner…</string>
    <string name="incall_scan_merging">Adding the voice scanner to the call…</string>
    <string name="incall_scan_listening">Listening to the other person. Your microphone is muted until the scan ends.</string>
    <string name="incall_scan_likely_human">Likely human</string>
    <string name="incall_scan_possibly_ai">Possibly AI-generated</string>
    <string name="incall_scan_likely_human_text">The voice sounded more like a person than a computer-generated voice.</string>
    <string name="incall_scan_possibly_ai_text">The voice has signs of a computer-generated or cloned voice.</string>
    <string name="incall_scan_can_be_wrong">This check can be wrong both ways: a phone line, noise or an unusual voice can confuse it, and new voice cloning may not be caught. Don\'t rely on it alone. If someone asks for money or codes, hang up and call them back on a number you know.</string>
    <string name="incall_scan_cues_title">They mentioned:</string>
    <string name="incall_scan_no_cues">No common scam phrases were heard.</string>
    <string name="incall_scan_no_result">The scanner couldn\'t check this voice: it heard too little speech, or the check failed. Your call goes on.</string>
    <string name="incall_scan_unavailable">The voice scan isn\'t available on this server or in your country.</string>
    <string name="incall_scan_supporter">The voice scan is a supporter feature.</string>
    <string name="incall_scan_signed_out">Sign in to scan voices.</string>
    <string name="incall_scan_failed">The voice scanner couldn\'t be added to the call. Your call goes on.</string>
