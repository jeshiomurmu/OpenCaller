<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Android binds this service for every incoming and outgoing call while OpenCaller holds the caller ID & spam
            role (RoleManager.ROLE_CALL_SCREENING); only Telecom may bind it (BIND_SCREENING_SERVICE). Declaration as in
            https://developer.android.com/reference/android/telecom/CallScreeningService.
        -->
        <service
            android:name=".screening.OpenCallerScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>

</manifest>
