# TLS and routing for infra/deploy/compose.prod.yml. Caddy gets and renews Let's Encrypt certificates for each domain
# (DNS must point at this server, ports 80 and 443 open). It replaces any X-Forwarded-For a client sends with the
# client's real address, which the server trusts (TRUST_FORWARDED_HEADERS).
{
	email {$ACME_EMAIL}
	metrics
	{$CADDY_EXTRA_GLOBAL}
}

# Caddy's own metrics for Prometheus, on the internal network only (port 2020 is not published).
:2020 {
	metrics
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

# The API, the business portal (/portal) and the unlist page.
{$API_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy server:8080
}

# Presigned links to MinIO (pictures, clips, recordings, spam lists). Only the bucket is reachable; MinIO checks each
# link's signature against this host name, which Caddy passes on unchanged.
{$MEDIA_DOMAIN} {
	import security_headers
	@bucket path /{$MEDIA_BUCKET:opencaller}/*
	handle @bucket {
		reverse_proxy minio:9000
	}
	respond 404
}

# LiveKit signalling (WebSocket) for app calls; media goes straight to LiveKit's UDP ports.
{$LIVEKIT_DOMAIN} {
	reverse_proxy livekit:7880
}

# Grafana, with its own login.
{$GRAFANA_DOMAIN} {
	import security_headers
	reverse_proxy grafana:3000
}

# Extra sites, one file each (e.g. caddy-sites/sip.caddy for the SIP certificate, telephony.md → Security).
import /etc/caddy/sites/*.caddy
