# Production settings for compose.prod.yml. ./init-env.sh copies this to .env and fills every secret marked
# <generated> with a fresh random value; fill in the rest by hand. .env is never committed (chmod 600).

# Release to run: the version of a GitHub release (its images are ghcr.io/jeshiomurmu/opencaller-*:<version>).
OPENCALLER_VERSION=1.1.0

# This server's public IPv4 address (LiveKit announces it for call media).
PUBLIC_IP=
# Four DNS names, all A records pointing at PUBLIC_IP.
API_DOMAIN=api.example.org
MEDIA_DOMAIN=media.example.org
LIVEKIT_DOMAIN=calls.example.org
GRAFANA_DOMAIN=grafana.example.org
# Only with the recording line, assistant or scanner (telephony.md → Security): the SIP server's TLS name.
# SIP_DOMAIN=sip.example.org
# Let's Encrypt account e-mail (expiry warnings).
ACME_EMAIL=
# Leave empty. "local_certs" = Caddy's own CA instead of Let's Encrypt, for a test without public DNS.
CADDY_EXTRA_GLOBAL=

POSTGRES_DB=opencaller
POSTGRES_USER=opencaller
POSTGRES_PASSWORD=<generated>
REDIS_PASSWORD=<generated>
MINIO_ROOT_USER=opencaller
MINIO_ROOT_PASSWORD=<generated>
MINIO_BUCKET=opencaller
JWT_SECRET=<generated>
OTP_PEPPER=<generated>
ADMIN_TOKEN=<generated>
ADMIN_WEB_USER=admin
ADMIN_WEB_PASSWORD=<generated>
LIVEKIT_API_KEY=opencaller
LIVEKIT_API_SECRET=<generated>
GRAFANA_ADMIN_PASSWORD=<generated>

# Sign-in codes by SMS (Twilio). Without a provider nobody can sign in; OTP_PROVIDER=log is refused in production.
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VOICE_FROM=

# Push for app calls, Flash messages and family alerts (ADR 0007). foss builds: VAPID keys (init-env.sh generates
# them). play builds: a Firebase service-account key in ./secrets and the project ID.
VAPID_PUBLIC_KEY=<generated>
VAPID_PRIVATE_KEY=<generated>
VAPID_SUBJECT=
FCM_SERVICE_ACCOUNT_FILE=
FCM_PROJECT_ID=

# Oldest app versionCode this server serves; older apps are asked to update (0 = none).
MIN_APP_VERSION_CODE=0
# true unlocks every supporter feature for everyone (a server for yourself or your community).
SELF_HOSTED=false
# Google Play billing (play builds): key file in ./secrets, package name, and a 32+ character secret (generated).
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_PACKAGE_NAME=
BILLING_ACCOUNT_SECRET=<generated>

# Nightly backups (backup/backup.sh): an rclone remote and path, configured in backup/rclone.conf (README → Backups).
# Use a "crypt" remote: the dumps contain account phone numbers.
BACKUP_REMOTE=offsite-crypt:opencaller
BACKUP_KEEP_DAYS=30
# true also copies the MinIO bucket (pictures, clips) off-site.
BACKUP_MEDIA=false
# Optional URL the backup pings after success (e.g. a healthchecks.io check), so a missed backup raises an alert.
BACKUP_PING_URL=
