# Copy to infra/docker/.env and replace every "change-me" value. Never commit .env.
# These credentials are for the local development stack only.

POSTGRES_DB=opencaller
POSTGRES_USER=opencaller
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

MINIO_ROOT_USER=opencaller
# MinIO requires at least 8 characters.
MINIO_ROOT_PASSWORD=change-me-too

# Server secrets, at least 32 characters each (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-at-least-32-random-characters
OTP_PEPPER=change-me-to-another-32-random-characters
# Admin endpoints on the internal port (run the scoring job or list build now; scripts/smoke.sh uses them).
# Remove the line to turn them off.
ADMIN_TOKEN=change-me-to-a-third-set-of-32-random-chars

# Admin web (business-claim review, OTP-source curation, sender-ID imports) on an internal port that compose never
# publishes. The password needs at least 32 characters; only the listed CIDR blocks may connect (127.0.0.1/32 =
# from inside the server container, e.g. `docker compose exec server curl -u admin:… localhost:8081/`).
# Remove ADMIN_WEB_PORT to turn the admin web off.
ADMIN_WEB_PORT=8081
ADMIN_WEB_USER=admin
ADMIN_WEB_PASSWORD=change-me-to-a-fourth-set-of-32-random-chars
ADMIN_WEB_ALLOWED_NETWORKS=127.0.0.1/32,::1/128

# Sign-in codes: `log` writes them to the server log (development only); `twilio` sends real SMS and needs
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and one of TWILIO_FROM / TWILIO_MESSAGING_SERVICE_SID.
# ENV=development
# OTP_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# Optional: a Twilio phone number that reads business-claim codes aloud in a call (for landlines).
# TWILIO_VOICE_FROM=

# Optional: MinIO base image (default: cgr.dev/chainguard/minio:latest). Must run `minio` as its entrypoint.
# MINIO_IMAGE=

# Optional: MinIO's address as the apps reach it, for profile-picture uploads (default: http://127.0.0.1:9000;
# an Android emulator on this machine needs http://10.0.2.2:9000).
# MINIO_PUBLIC_ENDPOINT=

# Optional: version reported by GET /health (e.g. GIT_SHA=$(git rev-parse --short HEAD)).
# GIT_SHA=dev
