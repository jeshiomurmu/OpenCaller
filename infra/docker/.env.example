# Copy to infra/docker/.env and replace every "change-me" value. Never commit .env.
# These credentials are for the local development stack only.

POSTGRES_DB=opencaller
POSTGRES_USER=opencaller
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

MINIO_ROOT_USER=opencaller
# MinIO requires at least 8 characters.
MINIO_ROOT_PASSWORD=change-me-too

# Server secrets, at least 32 characters each (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-at-least-32-random-characters
OTP_PEPPER=change-me-to-another-32-random-characters

# Sign-in codes: `log` writes them to the server log (development only); `twilio` sends real SMS and needs
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and one of TWILIO_FROM / TWILIO_MESSAGING_SERVICE_SID.
# ENV=development
# OTP_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=

# Optional: MinIO base image (default: cgr.dev/chainguard/minio:latest). Must run `minio` as its entrypoint.
# MINIO_IMAGE=

# Optional: version reported by GET /health (e.g. GIT_SHA=$(git rev-parse --short HEAD)).
# GIT_SHA=dev
