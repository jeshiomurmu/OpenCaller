# Copy to infra/docker/.env and replace every "change-me" value. Never commit .env.
# These credentials are for the local development stack only.

POSTGRES_DB=opencaller
POSTGRES_USER=opencaller
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

MINIO_ROOT_USER=opencaller
# MinIO requires at least 8 characters.
MINIO_ROOT_PASSWORD=change-me-too

# Server secrets, at least 32 characters each (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-at-least-32-random-characters
OTP_PEPPER=change-me-to-another-32-random-characters
# Admin endpoints on the internal port (run the scoring job or list build now; scripts/smoke.sh uses them).
# Remove the line to turn them off.
ADMIN_TOKEN=change-me-to-a-third-set-of-32-random-chars

# Admin web (business-claim review, OTP-source curation, sender-ID imports) on an internal port that compose never
# publishes. The password needs at least 32 characters; only the listed CIDR blocks may connect (127.0.0.1/32 =
# from inside the server container, e.g. `docker compose exec server curl -u admin:… localhost:8081/`).
# Remove ADMIN_WEB_PORT to turn the admin web off.
ADMIN_WEB_PORT=8081
ADMIN_WEB_USER=admin
ADMIN_WEB_PASSWORD=change-me-to-a-fourth-set-of-32-random-chars
ADMIN_WEB_ALLOWED_NETWORKS=127.0.0.1/32,::1/128

# App calls (LiveKit): the API secret shared by the server (which signs room tokens) and the livekit service, at
# least 32 characters. LIVEKIT_URL is how phones reach LiveKit (default ws://127.0.0.1:7880, this machine only);
# for phones on the network set LIVEKIT_BIND=0.0.0.0, LIVEKIT_NODE_IP=<this machine's LAN or public IP> and
# LIVEKIT_URL=ws://<that IP>:7880 (wss:// behind a TLS proxy in production, see README.md).
LIVEKIT_API_SECRET=change-me-to-a-fifth-set-of-32-random-chars
# LIVEKIT_API_KEY=opencaller
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_BIND=127.0.0.1
# LIVEKIT_NODE_IP=127.0.0.1

# Push for call invites and Flash messages (every push carries only a random id, ADR 0007). Without either provider
# app calls and Flash messages are off. Web Push / UnifiedPush (foss builds): `scripts/vapid-keys.sh >> .env`, plus
# a contact address for push services. FCM (play builds): a Firebase service-account key mounted into the server
# container and the Firebase project ID.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.org
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# FCM_PROJECT_ID=

# Recording line (Phase 13, ADR 0009; setup: infra/deploy/telephony.md, services: compose.telephony.yml). Off unless
# RECORDING_LINES and RECORDING_AGENT_TOKEN are set. RECORDING_LINES lists the lines' numbers (E.164, comma-separated,
# one per country); the server gives each user the line in their own country.
# RECORDING_LINES=+8800000000000,+910000000000
# RECORDING_AGENT_TOKEN=change-me-to-a-sixth-set-of-32-random-chars
# RECORDING_DOWNLOAD_GRACE_MINUTES=30
#
# RECORDING_COUNTRIES: where recording is approved (ISO 3166 codes). Default: BD,IN (Bangladesh, India; the
# project owner's decision of 2026-11-10). Every other country is OFF. Turning one on is STRICTLY the operator's
# decision and MUST be approved after the operator's own legal review of that country's call-recording and consent
# law; many countries and US states require every party's consent, which a beep alone may not satisfy. OpenCaller is
# open source: self-hosters set this list to fit their own legal advice. The admin web can also switch a country
# on or off (audit-logged). Placeholders, each to be approved before it is added:
#   AU  Australia         - needs approval after legal review
#   BR  Brazil            - needs approval after legal review
#   CA  Canada            - needs approval after legal review
#   DE  Germany           - needs approval after legal review
#   FR  France            - needs approval after legal review
#   GB  United Kingdom    - needs approval after legal review
#   ID  Indonesia         - needs approval after legal review
#   LK  Sri Lanka         - needs approval after legal review
#   MY  Malaysia          - needs approval after legal review
#   NP  Nepal             - needs approval after legal review
#   PK  Pakistan          - needs approval after legal review
#   SG  Singapore         - needs approval after legal review
#   US  United States     - needs approval after legal review (state laws differ; several need all-party consent)
#   ZA  South Africa      - needs approval after legal review
# RECORDING_COUNTRIES=BD,IN
# Example after approval for one more country (do not uncomment without that approval):
# RECORDING_COUNTRIES=BD,IN,NP
#
# Telephony overlay only: MinIO as LiveKit Egress reaches it, and the credentials it uploads with (default: the
# MinIO root user above; use a user limited to recordings/ in production). Optional spoken announcement (WAV).
# RECORDING_S3_ENDPOINT=http://127.0.0.1:9000
# RECORDING_S3_ACCESS_KEY=
# RECORDING_S3_SECRET_KEY=
# RECORDING_ANNOUNCEMENT_WAV=/announcements/recording-en.wav
# Transcripts (profile `transcripts`): a faster-whisper model name or folder.
# WHISPER_MODEL=small
#
# Call assistant (Phase 13, ADR 0010; profile `assistant`, setup in infra/deploy/telephony.md). ASSISTANT_NUMBERS is
# the pool (E.164, comma-separated): each user who turns the assistant on gets one number of their country. Needs
# RECORDING_AGENT_TOKEN and LiveKit. Minutes a month per user (0 = no cap) and the longest call.
# ASSISTANT_NUMBERS=+8800000000001,+8800000000002
# ASSISTANT_MONTHLY_MINUTES=100
# ASSISTANT_MAX_CALL_MINUTES=5
# The agent's providers: openai, deepgram, elevenlabs or google for speech (STT, TTS); openai or google for the
# language model. OpenAI-compatible servers of your own: set the *_BASE_URL (no OpenAI key needed then).
# ASSISTANT_LANGUAGE=en
# ASSISTANT_STT=openai
# ASSISTANT_LLM=openai
# ASSISTANT_TTS=openai
# ASSISTANT_STT_MODEL=
# ASSISTANT_LLM_MODEL=
# ASSISTANT_TTS_MODEL=
# ASSISTANT_TTS_VOICE=
# ASSISTANT_STT_BASE_URL=
# ASSISTANT_LLM_BASE_URL=
# ASSISTANT_TTS_BASE_URL=
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVEN_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# Sign-in codes: `log` writes them to the server log (development only); `twilio` sends real SMS and needs
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and one of TWILIO_FROM / TWILIO_MESSAGING_SERVICE_SID.
# ENV=development
# OTP_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# Optional: a Twilio phone number that reads business-claim codes aloud in a call (for landlines).
# TWILIO_VOICE_FROM=

# Supporter tier. SELF_HOSTED=true unlocks every supporter feature for everyone on this server.
# SELF_HOSTED=false
# Optional Google Play billing (play builds): a service-account key (JSON) with access to the app in Play Console,
# mounted into the server container, the app's package name, and a secret of at least 32 characters that binds each
# purchase to its account (never change it once purchases exist).
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/run/secrets/play-service-account.json
# GOOGLE_PLAY_PACKAGE_NAME=io.github.jeshiomurmu.opencaller
# GOOGLE_PLAY_PRODUCT_ID=opencaller_supporter
# BILLING_ACCOUNT_SECRET=

# Optional: MinIO base image (default: cgr.dev/chainguard/minio:latest). Must run `minio` as its entrypoint.
# MINIO_IMAGE=

# Optional: MinIO's address as the apps reach it, for profile-picture uploads (default: http://127.0.0.1:9000;
# an Android emulator on this machine needs http://10.0.2.2:9000).
# MINIO_PUBLIC_ENDPOINT=

# Optional: version reported by GET /health (e.g. GIT_SHA=$(git rev-parse --short HEAD)).
# GIT_SHA=dev
